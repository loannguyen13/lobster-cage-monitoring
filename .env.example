MQTT_HOST=127.0.0.1
MQTT_PORT=18884
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=<generated by edge/setup_mqtt.py>
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=<generated by edge/setup_mqtt.py>
# Required only for a TLS broker outside loopback:
MQTT_CA_FILE=
GATEWAY_ALLOWED_DEVICES=LOBSTER_CAGE_VANPHONG_01
GATEWAY_MQTT_CLIENT_ID=lobster-gateway
GATEWAY_SEND_INTERVAL=5
GATEWAY_DAILY_UNITS=500
# Receipt-time deadline for collecting six metrics with identical event timestamps.
GATEWAY_ASSEMBLY_TIMEOUT_SECONDS=60
# IoT Hub > Devices > pond-gateway-01 > Primary connection string.
# Must contain DeviceId=pond-gateway-01; this is NOT the Event Hub read connection.
IOTHUB_DEVICE_CONNECTION_STRING=

# Dashboard local API: add these to existing .env.local, never overwrite credentials.
PGHOST=
PGPORT=5432
PGDATABASE=
PGSSLROOTCERT=backend/certs/azure-postgresql-roots.pem
API_PGUSER=lobster_api
API_PGPASSWORD=
# Generate a random signing key (32+ bytes); keep only in local/Azure settings.
AUTH_JWT_SECRET=
AUTH_TOKEN_MINUTES=60
API_ALLOWED_ORIGINS=http://localhost:5173
# The Function runs packaged-model inference directly; no ML API URL is needed.
PREDICTIONS_ENABLED=false
PREDICTION_BATCH_SIZE=50
PREDICTION_MAX_READING_AGE_MINUTES=15
