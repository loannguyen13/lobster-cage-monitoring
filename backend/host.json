{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "http": { "routePrefix": "" },
    "eventHubs": {
      "batchCheckpointFrequency": 1,
      "prefetchCount": 16,
      "initialOffsetOptions": { "type": "fromStart" }
    }
  },
  "logging": {
    "logLevel": { "default": "Warning", "Function": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": true } }
  }
}
